{
  "name": "diangu",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply diangu --local",
    "db:migrate:remote": "wrangler d1 migrations apply diangu --remote",
    "db:seed:local": "wrangler d1 execute diangu --local --file=src/db/seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute diangu --remote --file=src/db/seed/seed.sql"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "@tailwindcss/postcss": "^4.1.0",
    "better-auth": "^1.3.4",
    "drizzle-orm": "^0.44.5",
    "next": "^16.0.0",
    "postcss": "^8.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250813.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
